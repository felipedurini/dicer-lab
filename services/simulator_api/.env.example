# Local development defaults. Do not put production credentials in this file.
APP_ENV=development
AUTH_MODE=local
APP_ORIGIN=http://127.0.0.1:3000
SIMULATOR_API_URL=http://127.0.0.1:8000
PORT=8000
API_HOST=127.0.0.1
WEB_RELEASE=local
LOG_LEVEL=INFO
NCBI_TOOL=DicerLab
# Recommended by NCBI E-utilities policy; set the maintainer team's valid email.
NCBI_EMAIL=
# Optional; required only for rates above the unauthenticated limit (3 requests/s).
NCBI_API_KEY=

# Production only; configure values in the host dashboard, never commit them.
# APP_ENV=production
# AUTH_MODE=supabase
# APP_ORIGIN=https://YOUR_WEB_HOST
# SIMULATOR_API_URL=https://YOUR_API_HOST
# API_HOST=0.0.0.0
# DATA_DIR=/data
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_JWT_ALGORITHMS=ES256
# ALLOWED_USER_IDS=authorized-uuid-1,authorized-uuid-2,authorized-uuid-3
