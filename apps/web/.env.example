# Local development defaults. AUTH_MODE=local is loopback-only and never for hosting.
APP_ENV=development
AUTH_MODE=local
APP_ORIGIN=http://127.0.0.1:3000
SIMULATOR_API_URL=http://127.0.0.1:8000
WEB_RELEASE=local

# Production deployment: set AUTH_MODE=supabase and these values from the
# authorized Supabase project. Never commit actual values or a service-role key.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
ALLOWED_USER_IDS=00000000-0000-4000-8000-000000000001,00000000-0000-4000-8000-000000000002,00000000-0000-4000-8000-000000000003
